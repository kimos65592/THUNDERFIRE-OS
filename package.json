{
  "name": "jarvis-cognitive-os",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "typecheck": "npm --workspace packages/core run typecheck && npm --workspace apps/web run typecheck",
    "test": "npm --workspace packages/core run test"
  }
}
